# ============================================================
# ZAPFIRE BACKEND — variáveis de ambiente
# Copie pra .env e preencha
# ============================================================

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ---- PostgreSQL ----
# Use o mesmo padrão que você já tem no MétriqAI.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zapfire?schema=public"

# ---- JWT (painel web) ----
# Gere com: openssl rand -hex 32
JWT_SECRET="troque-por-um-secret-forte-gerado-com-openssl-rand-hex-32"

# ---- Painel web (Next.js) ----
# URL base pro painel — usada em emails (magic link, etc).
PANEL_BASE_URL="http://localhost:3001"

# ---- Webhook Kirvano ----
# Token que a Kirvano manda no header X-Kirvano-Token.
# Se vazio, o endpoint de webhook responde 401 em toda request.
KIRVANO_WEBHOOK_TOKEN=""

# ---- Resend (envio de emails transacionais) ----
# Se vazio, o sistema entra em modo MOCK (loga no console, não envia nada).
# Perfeito pra desenvolvimento.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Zapfire <contato@zapfire.com.br>"

# ---- Admin inicial (pra seed) ----
ADMIN_EMAIL="melfi@improvavel.com.br"
ADMIN_PASSWORD="troque-isso-depois"
