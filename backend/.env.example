# ============================================================
# ZAPFIRE BACKEND — variáveis de ambiente
# Copie pra .env e preencha
# ============================================================

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL — use o mesmo padrão que você já tem no MétriqAI
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zapfire?schema=public"

# JWT (pra painel web do assinante, ainda não usado nas rotas da extensão)
JWT_SECRET="troque-por-um-secret-forte-gerado-com-openssl-rand-base64-32"

# Pagar.me — webhook
PAGARME_API_KEY=""
PAGARME_WEBHOOK_SECRET=""

# Admin inicial (pra seed)
ADMIN_EMAIL="melfi@improvavel.com.br"
ADMIN_PASSWORD="troque-isso-depois"
