# ============================================================
# ZAPFIRE — .env do docker-compose (raiz do deploy)
# ============================================================
# ESTE arquivo NÃO é o .env do backend ou do web — esses ficam
# em backend/.env e web/.env (ver os respectivos .env.example).
#
# Este aqui é o .env que o docker-compose.yml lê pra interpolar
# variáveis ${...} dentro do compose (principalmente build args
# que precisam estar disponíveis no momento do `docker build`).
#
# Onde mora em produção:
#   ~/zapfire/.env  (no VPS Hostinger)
#
# Não fica no git (.gitignored) — copie este arquivo pra .env e
# preencha. Cada máquina nova precisa criar o .env manualmente.
#
# Por que isso existe: NEXT_PUBLIC_* do Next.js é "baked" no
# build (não em runtime). Se a env não está disponível no momento
# do `docker compose up --build web`, o bundle vai pro ar com
# string vazia e o painel quebra silenciosamente (Caio descobriu
# isso na marra em 20/05/2026 — login parou de funcionar após um
# rebuild que não tinha o .env).
# ============================================================

# URL completa da API consumida pelo painel (incluindo /api/v1).
# Em prod aponta pro backend no VPS via api.zapfire.com.br.
# Em dev local pode ser http://localhost:3000/api/v1.
NEXT_PUBLIC_API_URL=https://api.zapfire.com.br/api/v1
